PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/iot_db

# JWT tự cài bằng crypto HMAC-SHA256, không cần thư viện ngoài
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN_SECONDS=86400

# MQTT
MQTT_BROKER=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SENSOR_TOPIC=home/sensors/data
MQTT_CONTROL_TOPIC=home/devices/control
MQTT_STATUS_TOPIC=home/devices/status
DEVICE_TIMEOUT_MS=10000

# Tài khoản seed ban đầu - đổi trước khi demo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Phạm Tiến Dũng
ADMIN_STUDENT_ID=B23DCAT064

# Tùy chọn: nếu đặt giá trị thì POST /api/v1/datasensor cần header x-internal-key
INTERNAL_API_KEY=
